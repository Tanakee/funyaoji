# ml/runner/.env に写して書く（cp .env.example .env）。.env はコミットしない（.gitignore にある）

# 登録の秘密。リポジトリの管理者が作る fine-grained PAT（このリポジトリだけ。Repository permissions の Administration を Read and write）。
# 管理者から、チャットに貼らずに受け取る（ml/runner/README.md）。manager のコンテナだけが持ち、ジョブのコンテナには入らない
ACCESS_TOKEN=

# この置き場所（マシン）の名前。英小文字・数字・- の20文字まで。人やマシンの本当の名前でなく、役目の名前にする（ml-1 など）。
# manager の片づけは、この名前のジョブのコンテナと登録だけを消す。ランナーの名前は funyaoji-ml-<この名前>-<日時>-<乱数>
RUNNER_INSTANCE=

# ジョブのコンテナに使わせる CPU のコアの数とメモリ。Docker Desktop（WSL2）の VM に割り当てた量より小さくする
RUNNER_CPUS=20
RUNNER_MEMORY=16g
